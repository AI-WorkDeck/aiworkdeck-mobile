/* 项目选择页。视觉语汇照抄 index 页：纯白底、发丝线分区（.rule 来自 tokens.wxss）、
 * 字级跨度做层级、无卡片阴影。 */

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 var(--gutter);
  background: var(--bg);
}

/* ---- 搜索：按名称过滤 ---------------------------------------------------- */
.search {
  height: var(--touch-min);
  margin: var(--s2) 0;
  padding: 0 var(--s3);
  border-radius: var(--s2);
  background: var(--bg-sunken);
  font-size: var(--t-small);
  color: var(--fg);
}

/* ---- 加载 / 错误 / 空态：三态共用一套居中布局 ---------------------------- */
.status {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s3);
  padding: var(--s16) var(--s4) 0;
  text-align: center;
}

.status__text {
  font-size: var(--t-small);
  color: var(--fg-muted);
  line-height: 1.6;
}

.status__btn {
  margin-top: var(--s2);
  padding: 0 var(--s5);
  border-radius: 999px;
  background: var(--accent-wash);
  color: var(--accent);
  font-size: var(--t-small);
  font-weight: 500;
}

/* ---- 分组列表 -------------------------------------------------------------- */
.groups {
  padding-top: var(--s4);
}

.group {
  margin-top: var(--s5);
}

.group:first-child {
  margin-top: 0;
}

.group__head {
  display: block;
  font-size: var(--t-micro);
  color: var(--fg-faint);
  letter-spacing: 0.08em;
  margin-bottom: var(--s2);
}

.item {
  justify-content: space-between;
  padding: 0 var(--s1);
}

.item__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item__name {
  font-size: var(--t-body);
  color: var(--fg);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item__sub {
  font-size: var(--t-nano);
  color: var(--fg-faint);
}

.item__check {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-left: var(--s2);
}

.item__chevron {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.item__files { margin-left: auto; padding: var(--s3); color: var(--accent); font-size: var(--t-small); }
