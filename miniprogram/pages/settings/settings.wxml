<nav-bar title="{{navTitle}}" show-back="{{true}}" />

<!-- 100vh 要减掉自定义导航栏的高度：nav-bar 自带一个等高占位在页面顶上，
     直接写 100vh 会把「退出登录」顶到首屏之外（本页没有别的内容可滚，用户会以为没有这个入口）。 -->
<view
  class="page"
  dir="{{dir}}"
  style="min-height: calc(100vh - {{metrics.navTotalHeight}}px); padding-bottom: {{metrics.bottomInset}}px;"
>

  <!-- 账号：名字在上，一眼知道登的是谁；手机号脱敏，与名字相同就不重复 -->
  <view class="account">
    <text class="account__name">{{accountName}}</text>
    <text wx:if="{{phoneText}}" class="account__sub mono">{{phoneText}}</text>
  </view>

  <!-- 费用：余额、充值、订阅、后付费放一起。
       显隐规则在 contract/schema/billing.schema.json，页面只按 kind 分支的结果渲染。
       充值入口与余额行**分开判**：NOT_CONNECTED 时行在、入口也在（dev-board#535） -->
  <text class="label group__head">{{billingLabel}}</text>
  <view wx:if="{{balanceVisible}}" class="row">
    <text class="row__label">{{balanceTitle}}</text>
    <view class="row__right">
      <text class="row__value">{{balanceText}}</text>
      <view wx:if="{{rechargeVisible}}" class="row__action tappable" bindtap="onRecharge">
        <text>{{rechargeText}}</text>
      </view>
    </view>
  </view>
  <text wx:if="{{balanceVisible && openHint}}" class="hint">{{openHint}}</text>
  <text wx:if="{{bqt}}" class="hint">{{bqtHint}}</text>

  <view wx:for="{{subscriptionRows}}" wx:key="label" class="row">
    <text class="row__label">{{item.label}}</text>
    <text class="row__value">{{item.value}}</text>
  </view>

  <block wx:if="{{!bqt}}">
  <view class="row"><text class="row__label">{{postpaidTitle}}</text><text class="row__value">{{postpaidState}}</text></view>
  <view wx:for="{{postpaidRows}}" wx:key="label" class="row"><text class="row__label">{{item.label}}</text><text class="row__value">{{item.value}}</text></view>
  <text class="hint">{{postpaidNotice}}</text>
  <button wx:if="{{canAcceptPostpaid}}" loading="{{postpaidBusy}}" disabled="{{postpaidBusy}}" bindtap="onAcceptPostpaid">{{postpaidAccept}}</button>
  <button wx:if="{{canResumeCloud}}" loading="{{postpaidBusy}}" disabled="{{postpaidBusy}}" bindtap="onResumeCloud">{{postpaidResume}}</button>
  <button wx:if="{{hasDebt}}" bindtap="onRecharge">{{postpaidRepay}}</button>
  <button wx:if="{{postpaidError}}" bindtap="onPostpaidRetry">{{postpaidError}}</button>
  </block>
  <view class="rule"></view>

  <!-- 云端存储：备份 -->
  <text class="label group__head">{{cloudLabel}}</text>
  <view class="row tappable" bindtap="onBackup">
    <text class="row__label">{{backupTitle}}</text>
    <text class="row__value">{{backupText}}</text>
  </view>
  <view class="rule"></view>

  <!-- 影像：拍摄后自动整理 -->
  <text class="label group__head">{{mediaLabel}}</text>
  <view class="row">
    <text class="row__label">{{organizeTitle}}</text>
    <switch checked="{{organizeEnabled}}" bindchange="onOrganizeChange" />
  </view>
  <text class="hint">{{organizeHint}}</text>
  <view class="rule"></view>

  <!-- 通用：语言 -->
  <text class="label group__head">{{generalLabel}}</text>
  <picker mode="selector" range="{{languageOptions}}" range-key="label" value="{{languageIndex}}" bindchange="onLanguageChange">
    <view class="row tappable">
      <text class="row__label">{{languageLabel}}</text>
      <text class="row__value">{{languageValue}}</text>
    </view>
  </picker>
  <view class="rule"></view>

  <!-- 关于：版本 -->
  <text class="label group__head">{{aboutLabel}}</text>
  <view class="row">
    <text class="row__label">{{versionLabel}}</text>
    <text class="row__value mono">{{versionText}}</text>
  </view>
  <view class="rule"></view>

  <view class="footer">
    <view class="footer__text tappable" bindtap="onLogout">
      <text>{{signOutText}}</text>
    </view>
  </view>
</view>
