/* 拍摄主界面。D7：拍摄流程走深色（--dk-* 令牌），器械感——深底、发丝线、
 * 等宽数字、状态色只做小圆点。整页不滚动，取景区吃掉剩余高度。 */

page {
  background: var(--dk-bg);
}

.cap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--dk-bg);
  box-sizing: border-box;
}

/* ---- 顶部信息层 ------------------------------------------------------------ */
.top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--s3);
  padding-left: var(--gutter);
  padding-right: var(--gutter);
  padding-bottom: var(--s3);
}

.top__project {
  min-width: 0;
  display: flex;
  flex-direction: column;
  /* 压过 .tappable 的居中，保持左对齐 */
  align-items: flex-start;
  gap: 2rpx;
}

.top__name-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.top__name {
  font-size: var(--t-heading);
  font-weight: 600;
  color: var(--dk-fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top__chevron {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.top__path {
  font-size: var(--t-micro);
  color: var(--dk-fg-muted);
}

.top__stats {
  display: flex;
  gap: var(--s3);
  flex-shrink: 0;
}

/* 「我的」入口。.tappable 的 88rpx 最小可点区是硬指标不缩小，顶栏跟着长高一点是代价。 */
.top__settings {
  flex-shrink: 0;
  margin-right: -8rpx;
}

.top__gear {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.75;
}

.top__stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.top__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

/* 失败不单独成桶，但不能藏：云端满、会话过期这类不重试也不会好 */
.top__failed {
  font-size: var(--t-nano);
  color: var(--st-failed);
}

.top__dot--waiting { background: var(--st-waiting); }
.top__dot--moving  { background: var(--st-moving); }
.top__dot--arrived { background: var(--st-arrived); }

.top__num {
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--dk-fg);
}

.top__label {
  font-size: var(--t-nano);
  color: var(--dk-fg-muted);
}

/* ---- 取景区 ----------------------------------------------------------------- */
.finder {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  background: #000000;
}

.finder__camera {
  width: 100%;
  height: 100%;
}

/* 相机权限被拒的降级态 */
.finder__denied {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 var(--s8);
  text-align: center;
  gap: var(--s3);
}

.finder__denied-title {
  font-size: var(--t-heading);
  font-weight: 600;
  color: var(--dk-fg);
}

.finder__denied-sub {
  font-size: var(--t-small);
  color: var(--dk-fg-muted);
  line-height: 1.6;
}

.finder__denied-btn {
  margin-top: var(--s2);
  min-height: var(--touch-min);
  display: flex;
  align-items: center;
  padding: 0 var(--s6);
  border-radius: var(--s2);
  background: var(--dk-surface);
  border: 1rpx solid var(--dk-rule);
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--dk-fg);
}

.finder__denied-alt {
  min-height: var(--touch-min);
  display: flex;
  align-items: center;
  font-size: var(--t-small);
  color: var(--dk-fg-muted);
  text-decoration: underline;
}

/* 录音档面板：无画面，深色 + 麦克风 */
.finder__audio {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--s4);
  background: var(--dk-surface);
}

.finder__audio-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.4;
}

.finder__audio-icon--live {
  opacity: 1;
  animation: audio-live 1.2s ease-in-out infinite;
}

@keyframes audio-live {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.finder__audio-hint {
  font-size: var(--t-small);
  color: var(--dk-fg-muted);
}

/* 能力降级提示：比 hint 再小一号、再淡一些，不抢录音状态 */
.finder__audio-note {
  font-size: var(--t-micro);
  color: var(--dk-fg-muted);
  opacity: 0.7;
  padding: 0 var(--gutter);
  text-align: center;
}

/* ---- 左下角淡水印：白字约 55% 透明度、等宽、微阴影，深色半透明衬底 -------- */
.wm {
  position: absolute;
  left: var(--s3);
  bottom: var(--s3);
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: var(--s1) var(--s2);
  border-radius: var(--s1);
  background: rgba(0, 0, 0, 0.35);
  pointer-events: none;
}

.wm__line {
  font-size: var(--t-micro);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.55);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.wm__line--name {
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- 录制中状态条 ----------------------------------------------------------- */
.rec {
  position: absolute;
  top: var(--s3);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: var(--s2);
  padding: var(--s1) var(--s3);
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
}

.rec__pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--st-failed);
  animation: rec-pulse 1.2s ease-in-out infinite;
}

@keyframes rec-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.rec__timer {
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--dk-fg);
}

.rec__segment {
  font-size: var(--t-micro);
  color: var(--dk-fg-muted);
}

/* ---- D6 能力边界明示 -------------------------------------------------------- */
.note {
  padding: var(--s2) var(--gutter);
}

.note__text {
  font-size: var(--t-micro);
  color: var(--dk-fg-muted);
  line-height: 1.5;
}

/* ---- 底部控制区 ------------------------------------------------------------- */
.ctrl {
  padding: 0 var(--gutter) var(--s3);
}

.ctrl__modes {
  display: flex;
  justify-content: center;
  gap: var(--s2);
  padding-bottom: var(--s3);
}

.ctrl__mode {
  min-height: var(--touch-min);
  display: flex;
  align-items: center;
  padding: 0 var(--s4);
  border-radius: 999rpx;
  font-size: var(--t-small);
  color: var(--dk-fg-muted);
  transition: color var(--d-fast) var(--e-out), background var(--d-fast) var(--e-out);
}

.ctrl__mode--on {
  color: var(--dk-fg);
  font-weight: 600;
  background: rgba(255, 255, 255, 0.12);
}

.ctrl__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 最近一件缩略图入口 */
.ctrl__recent {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--s2);
  overflow: hidden;
  border: 1rpx solid var(--dk-rule);
  background: var(--dk-surface);
  flex-shrink: 0;
}

.ctrl__recent-img {
  width: 100%;
  height: 100%;
}

.ctrl__recent-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ctrl__recent-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.55;
}

.ctrl__recent-dot {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.6);
}

.ctrl__recent-dot.dot--waiting { background: var(--st-waiting); }
.ctrl__recent-dot.dot--moving  { background: var(--st-moving); }
.ctrl__recent-dot.dot--arrived { background: var(--st-arrived); }
.ctrl__recent-dot.dot--failed  { background: var(--st-failed); }

.ctrl__recent-empty {
  width: 100%;
  height: 100%;
}

/* 大快门：约屏宽 16%（750rpx 设计稿 → 120rpx），外环 + 内芯 */
.shutter {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.shutter__core {
  transition: border-radius var(--d-fast) var(--e-out), transform var(--d-fast) var(--e-out);
}

.shutter__core--photo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.shutter__core--rec {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--st-failed);
}

.shutter__core--stop {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--st-failed);
}

/* 存相册开关：与左侧缩略图入口同宽，保持快门居中；开态提亮，关态压暗 */
.ctrl__album {
  width: 104rpx;
  flex-shrink: 0;
  flex-direction: column;
  gap: 2rpx;
  border-radius: var(--s2);
  border: 1rpx solid var(--dk-rule);
  transition: opacity var(--d-fast) var(--e-out), border-color var(--d-fast) var(--e-out);
  opacity: 0.55;
}

.ctrl__album--on {
  opacity: 1;
  border-color: rgba(255, 255, 255, 0.45);
}

.ctrl__album-text {
  font-size: var(--t-micro);
  color: var(--dk-fg);
}

.ctrl__album-state {
  font-size: var(--t-micro);
  color: var(--dk-fg-muted);
}

.pause-row { display: flex; flex-direction: column; align-items: center; margin-bottom: var(--s2); gap: var(--s1); }
.pause-control { font-size: var(--t-small); line-height: 1.4; padding: var(--s2) var(--s4); color: var(--dk-fg); background: var(--dk-surface); border: 1rpx solid var(--dk-rule); }
.pause-note { font-size: var(--t-micro); color: var(--dk-fg-muted); text-align: center; }
.rec__paused { color: var(--dk-fg); font-size: var(--t-small); }
.rec--paused { max-width: 90%; flex-wrap: wrap; justify-content: center; }

.personal-return { position: absolute; left: 24rpx; bottom: 190rpx; z-index: 30; width: auto; font-size: 24rpx; }
