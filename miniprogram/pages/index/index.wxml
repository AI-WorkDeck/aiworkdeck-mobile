<!-- 取景器优先的拍摄主界面（D7 深色）。
     顶部信息 / 中部取景 + 左下角淡水印 / 底部三档模式 + 大快门 + 最近缩略图入口。
     导航高度只用全局度量（metrics），页面不自己测量。 -->
<view class="cap" style="padding-bottom: {{metrics.bottomInset}}px;">

  <!-- 顶部信息层 -->
  <view class="top" style="padding-top: {{metrics.navTotalHeight}}px;">
    <view class="top__project tappable" bindtap="onSwitchProject">
      <view class="top__name-row">
        <text class="top__name">{{project.name}}</text>
        <image class="top__chevron" src="{{Icon.chevronWhite}}" mode="aspectFit" />
      </view>
      <text class="top__path">{{archiveTo}}</text>
    </view>
    <view class="top__stats tappable" bindtap="onOpenQueue">
      <view class="top__stat">
        <view class="top__dot top__dot--waiting"></view>
        <text class="top__num mono">{{tally.uploading}}</text>
        <text class="top__label">{{phaseLabel.uploading}}</text>
        <!-- 失败不单独成桶，但不能藏：云端满、会话过期这类不重试也不会好 -->
        <text wx:if="{{tally.failed > 0}}" class="top__failed">{{failedSuffix}}</text>
      </view>
      <view class="top__stat">
        <view class="top__dot top__dot--moving"></view>
        <text class="top__num mono">{{tally.staged}}</text>
        <text class="top__label">{{phaseLabel.staged}}</text>
      </view>
      <view class="top__stat">
        <view class="top__dot top__dot--arrived"></view>
        <text class="top__num mono">{{tally.landed}}</text>
        <text class="top__label">{{phaseLabel.landed}}</text>
      </view>
    </view>
    <!-- 「我的」入口：账户、余额与充值、退出登录都在那一页（dev-board#535） -->
    <view class="top__settings tappable" bindtap="onOpenSettings" aria-label="{{settingsLabel}}">
      <image class="top__gear" src="{{Icon.gearWhite}}" mode="aspectFit" />
    </view>
  </view>

  <!-- 取景区 -->
  <view class="finder">
    <!-- cameraMounted 由 onShow/onHide 控制：页面被别的页盖住时把原生组件整个卸掉，
         回来再挂一个新的（dev-board#536）。bindstop 收「摄像头非正常终止」，同样靠重挂恢复。 -->
    <camera
      wx:if="{{cameraMounted && mode !== 'audio' && cameraState !== 'denied'}}"
      class="finder__camera"
      device-position="back"
      flash="off"
      binderror="onCameraError"
      bindstop="onCameraStop"
      bindinitdone="onCameraReady"
    />

    <!-- 相机权限被拒 / 初始化失败的降级态：明示 + 去设置 + 系统相机兜底 -->
    <view wx:if="{{mode !== 'audio' && cameraState === 'denied'}}" class="finder__denied">
      <text class="finder__denied-title">{{labels.cameraDeniedTitle}}</text>
      <text class="finder__denied-sub">{{labels.cameraDeniedSub}}</text>
      <view class="finder__denied-btn tappable" bindtap="onOpenCameraSetting">
        <text>{{labels.openSettings}}</text>
      </view>
      <view class="finder__denied-alt tappable" bindtap="onSystemCapture">
        <text>{{labels.systemCamera}}</text>
      </view>
    </view>

    <!-- 录音档：无取景画面，深色面板 + 麦克风 -->
    <view wx:if="{{mode === 'audio'}}" class="finder__audio">
      <image class="finder__audio-icon {{recording && !recordPaused ? 'finder__audio-icon--live' : ''}}" src="{{Icon.micWhite}}" mode="aspectFit" />
      <text wx:if="{{recording && recordPaused}}" class="finder__audio-hint">{{labels.paused}} · {{labels.remember}}</text>
      <text wx:elif="{{recording && recordInterrupted}}" class="finder__audio-hint">{{recordInterruptedText}}</text>
      <text wx:else class="finder__audio-hint">{{recording ? labels.audioRecordingHint : labels.audioIdleHint}}</text>
      <text wx:if="{{recording && !recordPaused && silenceUnavailable}}" class="finder__audio-note">{{labels.silenceUnavailable}}</text>
      <text wx:if="{{audioNote}}" class="finder__audio-note">{{audioNote}}</text>
    </view>

    <!-- 左下角淡水印：仅界面叠加，不写入影像（保护取证哈希链的刻意决策） -->
    <view wx:if="{{mode !== 'audio' && cameraState === 'ready'}}" class="wm">
      <text class="wm__line mono">{{wmTime}}</text>
      <text class="wm__line wm__line--name">{{project.name}}</text>
    </view>

    <!-- 录制中状态条（录像/录音共用） -->
    <view wx:if="{{recording}}" class="rec {{recordPaused ? 'rec--paused' : ''}}">
      <view wx:if="{{!recordPaused}}" class="rec__pulse"></view>
      <text wx:else class="rec__paused">{{labels.paused}} · {{labels.remember}}</text>
      <text class="rec__timer mono">{{recordElapsed}}</text>
      <text class="rec__segment">{{recordSegmentText}}</text>
    </view>
  </view>

  <!-- D6：能力边界明示，随模式切换 -->
  <view class="note">
    <text class="note__text">{{modeNote}}</text>
  </view>

  <!-- 底部控制区 -->
  <view class="ctrl">
    <view class="ctrl__modes">
      <view
        class="ctrl__mode tappable {{mode === 'photo' ? 'ctrl__mode--on' : ''}}"
        data-mode="photo"
        bindtap="onSwitchMode"
      ><text>{{labels.photo}}</text></view>
      <view
        class="ctrl__mode tappable {{mode === 'video' ? 'ctrl__mode--on' : ''}}"
        data-mode="video"
        bindtap="onSwitchMode"
      ><text>{{labels.video}}</text></view>
      <view
        class="ctrl__mode tappable {{mode === 'audio' ? 'ctrl__mode--on' : ''}}"
        data-mode="audio"
        bindtap="onSwitchMode"
      ><text>{{labels.audio}}</text></view>
    </view>

    <view wx:if="{{recording}}" class="pause-row">
      <button class="pause-control" bindtap="onPauseResume" disabled="{{pausePending || recordInterrupted}}">{{recordPaused ? (mode === 'audio' ? labels.resumeAudio : labels.resumeVideo) : (mode === 'audio' ? labels.pauseAudio : labels.pauseVideo)}}</button>
      <text wx:if="{{mode === 'video'}}" class="pause-note">{{labels.videoPauseNote}}</text>
    </view>
    <view class="ctrl__row">
      <!-- 最近一件缩略图入口：真图（照片原图 / 录像帧图），audio 用色块底 + 麦克风 -->
      <view class="ctrl__recent tappable" bindtap="onOpenGallery" aria-label="{{labels.openGalleryA11y}}">
        <block wx:if="{{recent}}">
          <image
            wx:if="{{recent.thumb}}"
            class="ctrl__recent-img"
            src="{{recent.thumb}}"
            mode="aspectFill"
            binderror="onRecentThumbError"
          />
          <view wx:else class="ctrl__recent-ph">
            <image class="ctrl__recent-icon" src="{{recent.icon}}" mode="aspectFit" />
          </view>
          <view class="ctrl__recent-dot {{recent.dotClass}}"></view>
        </block>
        <view wx:else class="ctrl__recent-empty"></view>
      </view>

      <!-- 大快门：照片白芯；录像/录音红芯，录制中变红方块 -->
      <view
        class="shutter tappable"
        bindtap="onShutter"
        aria-label="{{mode === 'photo' ? labels.shoot : (recording ? labels.stopRecord : labels.startRecord)}}"
      >
        <view class="shutter__core {{mode === 'photo' ? 'shutter__core--photo' : (recording ? 'shutter__core--stop' : 'shutter__core--rec')}}"></view>
      </view>

      <!-- 存相册开关（对齐 iOS 设置页「同时存入系统相册」，默认关，知情选择） -->
      <view
        class="ctrl__album tappable {{saveToAlbum ? 'ctrl__album--on' : ''}}"
        bindtap="onToggleAlbum"
        aria-label="{{saveToAlbum ? labels.albumOnA11y : labels.albumOffA11y}}"
      >
        <text class="ctrl__album-text">{{labels.saveToAlbumShort}}</text>
        <text class="ctrl__album-state">{{saveToAlbum ? labels.stateOn : labels.stateOff}}</text>
      </view>
    </view>
  </view>
</view>
