<nav-bar title="{{navTitle}}" />
<view class="page" style="padding-bottom: {{metrics.bottomInset}}px;">
  <view class="region-bar">
    <view class="region tappable" bindtap="onToggleRegion" aria-role="switch" aria-label="{{regionA11y}}">
      <view class="region__track region__track--{{region}}"><view class="region__thumb"></view>
        <text class="region__label region__label--cn">{{regionCnText}}</text>
        <text class="region__label region__label--intl">{{regionIntlText}}</text>
      </view>
    </view>
  </view>
  <block wx:if="{{!showLogin}}">
    <view class="notice">{{notice}}</view>
    <view class="submit tappable" bindtap="onGetApp"><text class="submit__text">{{getAppText}}</text></view>
  </block>
  <block wx:if="{{showLogin}}">
    <view class="hero"><view class="hero__title">{{navTitle}}</view><view class="hero__sub">{{hintText}}</view></view>
    <view class="form">
      <view class="field"><text class="field__label">{{phoneLabel}}</text>
        <input class="field__input mono" type="number" maxlength="11" placeholder="{{phonePlaceholder}}" value="{{phone}}" disabled="{{loggingIn}}" bindinput="onPhoneInput" />
      </view><view class="rule"></view>
      <view class="field"><text class="field__label">{{passwordLabel}}</text>
        <input class="field__input" password="{{true}}" maxlength="128" placeholder="{{reviewMode ? reviewCredential : passwordPlaceholder}}" value="{{password}}" disabled="{{loggingIn}}" bindinput="onPasswordInput" />
      </view><view class="rule"></view>
    </view>
    <view class="submit tappable {{submitDisabled ? 'submit--disabled' : ''}}" bindtap="onLogin"><text class="submit__text">{{loggingIn ? workingText : submitText}}</text></view>
    <view class="alt tappable" bindtap="onReview"><text class="alt__text">{{reviewMode ? passwordModeText : reviewText}}</text></view>
    <view class="alt tappable" bindtap="onRegister"><text class="alt__text">{{registerText}}</text></view>
    <view class="alt tappable" bindtap="onReset"><text class="alt__text">{{resetText}}</text></view>
    <view class="footer"><text class="footer__text">{{webHint}}</text></view>
  </block>
</view>
