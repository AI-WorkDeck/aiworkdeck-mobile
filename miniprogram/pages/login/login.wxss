/* 登录页。视觉语汇照抄 index 页：纯白底、发丝线分区（.rule 来自 tokens.wxss）、
 * 字级跨度做层级、无卡片阴影——不用 box-shadow，分区靠 .rule 与留白。 */

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 var(--gutter);
  background: var(--bg);
}

/* ---- 账号区域：右上角胶囊开关（dev-board#839）--------------------------------
 * 仿云厂商 App 登录页的「中国站 / 国际站」：一条圆角轨道并排两个短标签，
 * 强调色滑块垫在当前项下面，切换时滑过去；选中字反白（用页面底色令牌，不引新色）。
 * 两个标签定宽，滑块与标签同宽，平移一个标签宽即到另一边——不依赖文字长短。 */
.region-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--s2);
  margin-top: var(--s2);
}

.lang-pill {
  padding: 0 var(--s3);
  height: 60rpx;
  line-height: 60rpx;
  border: 1rpx solid var(--rule);
  border-radius: 999px;
  background: var(--bg-sunken);
}

.lang-pill__text {
  font-size: var(--t-small);
  font-weight: 500;
  color: var(--fg-muted);
}

.region__track {
  position: relative;
  display: flex;
  padding: 4rpx;
  border: 1rpx solid var(--rule);
  border-radius: 999px;
  background: var(--bg-sunken);
}

.region__thumb {
  position: absolute;
  top: 4rpx;
  bottom: 4rpx;
  left: 4rpx;
  width: 120rpx;
  border-radius: 999px;
  background: var(--accent);
  transition: transform var(--d-base) var(--e-out);
}

.region__track--intl .region__thumb {
  transform: translateX(120rpx);
}

.region__label {
  position: relative;
  display: block;
  width: 120rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: var(--t-small);
  font-weight: 500;
  color: var(--fg-muted);
  transition: color var(--d-base) var(--e-out);
}

.region__track--cn .region__label--cn,
.region__track--intl .region__label--intl {
  color: var(--bg);
  font-weight: 600;
}

/* 海外版：小程序登不了，说明文字占标题位，再给一个「下载 App」实心按钮 */
.notice {
  margin-top: var(--s2);
  font-size: var(--t-body);
  color: var(--fg);
  line-height: 1.7;
}

.hero {
  margin-top: var(--s2);
}

.hero__title {
  font-size: var(--t-title);
  font-weight: 600;
  color: var(--fg);
  letter-spacing: -0.01em;
}

.hero__sub {
  margin-top: var(--s2);
  font-size: var(--t-small);
  color: var(--fg-muted);
  line-height: 1.6;
}

/* ---- 表单：发丝线分区，不做输入框边框 ------------------------------------ */
.form {
  margin-top: var(--s6);
}

.field {
  padding: var(--s3) 0;
}

.field__label {
  font-size: var(--t-small);
  color: var(--fg-muted);
}

.field__input {
  display: block;
  width: 100%;
  margin-top: var(--s2);
  height: 56rpx;
  font-size: var(--t-title);
  color: var(--fg);
}

.field__placeholder {
  color: var(--fg-faint);
  font-weight: 400;
}

.field__row {
  display: flex;
  align-items: center;
  gap: var(--s3);
}

.field__input--code {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  padding: 0 var(--s4);
  border-radius: 999px;
  background: var(--accent-wash);
  color: var(--accent);
}

.code-btn--disabled {
  background: var(--bg-sunken);
  color: var(--fg-faint);
}

.code-btn__text {
  font-size: var(--t-small);
  font-weight: 500;
  white-space: nowrap;
}

/* ---- 提交：全 App 唯一一处强调色实心按钮，仍不加阴影 ----------------------
 * 一键登录必须是 <button open-type="getPhoneNumber">，所以这里要把微信给 button 的
 * 默认边框/内边距/伪元素边线全抹掉，才能和下面那个 view 版按钮长得一模一样。 */
.submit {
  margin-top: var(--s8);
  height: 96rpx;
  padding: 0;
  border: none;
  border-radius: var(--s2);
  background: var(--accent);
  line-height: normal;
}

.submit::after {
  border: none;
}

/* 短信表单里的提交按钮跟在发丝线下面，不用再留一整段 */
.submit--sms {
  margin-top: var(--s6);
}

/* 「用短信验证码登录」：文字按钮，是次级路径，不跟一键登录抢注意力 */
.alt {
  margin-top: var(--s4);
}

.alt__text {
  font-size: var(--t-small);
  color: var(--accent);
}

.submit--disabled {
  background: var(--rule-strong);
}

.submit__text {
  color: #FFFFFF;
  font-size: var(--t-heading);
  font-weight: 600;
  letter-spacing: 0.02em;
}

.footer {
  margin-top: auto;
  padding: var(--s6) 0;
  text-align: center;
}

.footer__text {
  font-size: var(--t-micro);
  color: var(--fg-faint);
  line-height: 1.6;
}
