<view class="page" style="padding-bottom: {{metrics.bottomInset}}px;">
  <view class="hero"><view class="hero__title">{{title}}</view><view class="hero__sub">{{hint}}</view></view>
  <button class="submit tappable" bindtap="onRegister">{{title}}</button>
  <view class="next__hint">{{webHint}}</view>
  <button class="submit tappable" bindtap="onEnterApp">{{loginText}}</button>
</view>
