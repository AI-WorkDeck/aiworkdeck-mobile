# 上架材料：审核联系人/演示账号是个人信息与凭据，公开仓不收
# 排除目录本身 git 就不会往里看，负向规则也就失效了，所以要排到文件一级
fastlane/metadata/review_information/*
!fastlane/metadata/review_information/*.example
# 截图是二进制大文件，且要从真机重拍，不入库
fastlane/screenshots/

# 会话交接文件，含凭据类内容，公开仓绝不能收
.remember/

.claude/worktrees/

android/local.properties
android/.gradle/
android/**/build/
android/.kotlin/

# 计划执行的工作目录（任务汇报等），不入库
.superpowers/

# Python 字节码
__pycache__/
*.pyc

