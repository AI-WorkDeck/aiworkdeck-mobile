{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "contract/capabilities.json 的形状。加它的原因（dev-board#425 复审）：在此之前 capabilities.json 没有任何校验——把 \"android\" 打成 \"andriod\"，gen 出来的安卓生成物是字符串 \"undefined\"，check.mjs 依旧全绿退出码 0，四端能力开关静默失真。\n\n所以这里**端名与取值都是封闭的**：每个能力必须恰好给出 ios / miniprogram / android / harmony 四端（多一个少一个都红），取值只能是该能力自己那套枚举。新增能力或新增端 = 契约变更，要同时改这份 schema 与 contract/tools/lib.mjs 的四端渲染。",
  "type": "object",
  "required": ["version", "clients", "capabilities", "previewExtensions", "backupConsentVersion"],
  "additionalProperties": false,
  "properties": {
    "previewExtensions": {"type": "object", "required": ["ios", "miniprogram", "android", "harmony"], "additionalProperties": false, "properties": {"ios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+$"}}, "miniprogram": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+$"}}, "android": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+$"}}, "harmony": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+$"}}}},
    "backupConsentVersion": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "version": { "type": "integer", "minimum": 1 },
    "clients": { "$comment": "端名与顺序都钉死：lib.mjs 的四个渲染函数按这些名字取值", "const": ["ios", "miniprogram", "android", "harmony"] },
    "capabilities": {
      "type": "object",
      "required": ["backgroundUpload", "maxVideoSeconds", "continuousSegments", "glassBlur", "deviceAttestation", "backgroundRecording", "recharge", "intlAccount"],
      "additionalProperties": false,
      "properties": {
        "backgroundUpload": { "$ref": "#/$defs/boolRow" },
        "maxVideoSeconds": { "$ref": "#/$defs/secondsRow" },
        "continuousSegments": { "$ref": "#/$defs/boolRow" },
        "glassBlur": { "$ref": "#/$defs/blurRow" },
        "deviceAttestation": { "$ref": "#/$defs/boolRow" },
        "backgroundRecording": { "$ref": "#/$defs/boolRow" },
        "recharge": { "$ref": "#/$defs/rechargeRow" },
        "intlAccount": { "$comment": "能否登录国际站（workdeck.ai）账号。小程序 false：微信请求域名必须 ICP 备案，.ai 域名备不了（dev-board#837）", "$ref": "#/$defs/boolRow" }
      }
    }
  },
  "$defs": {
    "notice": { "$comment": "文案键，check.mjs 的引用闭合另查它在不在 strings.json 里", "type": "string", "minLength": 1 },
    "boolRow": { "type": "object", "required": ["ios", "miniprogram", "android", "harmony"], "additionalProperties": false,
      "properties": { "ios": { "type": "boolean" }, "miniprogram": { "type": "boolean" },
                      "android": { "type": "boolean" }, "harmony": { "type": "boolean" },
                      "degradedNotice": { "$ref": "#/$defs/notice" } } },
    "secondsRow": { "$comment": "上限秒数；null = 不限", "type": "object",
      "required": ["ios", "miniprogram", "android", "harmony"], "additionalProperties": false,
      "properties": { "ios": { "$ref": "#/$defs/seconds" }, "miniprogram": { "$ref": "#/$defs/seconds" },
                      "android": { "$ref": "#/$defs/seconds" }, "harmony": { "$ref": "#/$defs/seconds" },
                      "degradedNotice": { "$ref": "#/$defs/notice" } } },
    "seconds": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
    "blurRow": { "$comment": "true / false / \"runtime\"（运行时探测）", "type": "object",
      "required": ["ios", "miniprogram", "android", "harmony"], "additionalProperties": false,
      "properties": { "ios": { "$ref": "#/$defs/blur" }, "miniprogram": { "$ref": "#/$defs/blur" },
                      "android": { "$ref": "#/$defs/blur" }, "harmony": { "$ref": "#/$defs/blur" },
                      "degradedNotice": { "$ref": "#/$defs/notice" } } },
    "blur": { "enum": [true, false, "runtime"] },
    "rechargeRow": { "$comment": "充值通道；external = 本端暂无支付通道，只放入口把用户引到别的端（recharge.external.* 那两句）；false = 本端连入口都不放", "type": "object",
      "required": ["ios", "miniprogram", "android", "harmony"], "additionalProperties": false,
      "properties": { "ios": { "$ref": "#/$defs/channel" }, "miniprogram": { "$ref": "#/$defs/channel" },
                      "android": { "$ref": "#/$defs/channel" }, "harmony": { "$ref": "#/$defs/channel" },
                      "degradedNotice": { "$ref": "#/$defs/notice" } } },
    "channel": { "enum": ["iap", "virtual", "wxpay-app", "external", false] }
  }
}
