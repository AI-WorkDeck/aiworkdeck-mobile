require "open3"
require "securerandom"
require "shellwords"
require "tmpdir"

# 全程走 App Store Connect API Key，不做交互登录、不碰 2FA。
# Key 是 Admin 角色（创建 Distribution 证书必须 Admin，Developer 角色会卡住）。
#
# 2026-09-05 起 iOS 只有一个 App：com.aiworkdeck.mobile.cn（北京京微资易，
# Team 8WKHZVR2W8），已全球上架。（bundle id 里的 .cn 与 App 备案绑定，不可改。）
# 另一条 App 记录（香港主体）已在 ASC 删除，对应的 create_app / sigh / beta /
# release lane 一并去掉（dev-board#445、#446）。

# cert 动作装 WWDR 中间证书时用的是裸 `curl -f`，没有重试。Apple 的
# certificateauthority CDN 会间歇性回 403 / 半路断流（2026-08-21 发版实测：
# AppleWWDRCAG2.cer 一次 403、一次 curl(56)），而 fastlane 只要 curl 非零就
# 直接 UI.user_error!("Could not install WWDR certificate") 整条 lane 挂掉——
# 哪怕那几张证书早就在钥匙串里。这个开关让它改用 --http1.1 --retry 3
# --retry-all-errors（fastlane 为 issue #20960 留的口子），重试后拿到证书、
# security import 报「已存在」，fastlane 认这条信息并放行。
ENV["FASTLANE_WWDR_USE_HTTP1_AND_RETRIES"] ||= "true"

default_platform(:ios)

# 主 App、录音 Live Activity 扩展与 Watch App 各要一份 App Store 描述文件。
# 都复用已备案的 Distribution 证书，由 ASC 管理，名字固定。
def app_store_profiles
  {
    "com.aiworkdeck.mobile.cn" => "AI WorkDeck AppStore",
    "com.aiworkdeck.mobile.cn.LiveActivity" => "AI WorkDeck LiveActivity AppStore",
    "com.aiworkdeck.mobile.cn.watchkitapp" => "AI WorkDeck Watch AppStore"
  }
end

# ---------------- AI WorkDeck（北京京微资易，Team 8WKHZVR2W8） ----------------
# 改这条 lane 前先读：
# 1) 凭据走 jwzy 团队那套 ASC Key（Admin），从 fastlane/.env 读
#    （ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH）。
# 2) 不跑 cert/sigh：从总表 §6.7 的原位 p12 导入临时 keychain，结束后删除。
#    三份既有 .mobileprovision 须先安装；本地参数见 LOCAL_SIGNING.md。
#    另：这张证书的公钥/SHA-1 已绑 App 备案，撤销重建=同步做备案变更。
# 3) 不需要把构建挂进测试组：内部测试组（942673b0…）建的时候
#    就是 hasAccessToAllBuilds，构建处理完自动对组可见。

def asc_key
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |k|
    UI.user_error!("missing #{k} (fastlane/.env, 见 5-Tech/EXTERNAL_SERVICES.md §6.7)") if ENV[k].to_s.empty?
  end
  app_store_connect_api_key(
    key_id:     ENV["ASC_KEY_ID"],
    issuer_id:  ENV["ASC_ISSUER_ID"],
    key_filepath: File.expand_path(ENV["ASC_KEY_PATH"]),
    in_house: false
  )
end

# Check both the selected toolchain and the exported binary before any upload.
def check_release_environment
  sh("python3", File.expand_path("../scripts/check-ios-release.py", __dir__), "environment")
end

def check_release_ipa(path)
  sh("python3", File.expand_path("../scripts/check-ios-release.py", __dir__), "ipa", path)
end

# security 的参数含口令，不能用会回显命令的 fastlane sh。
def local_signing_security(*args)
  output, _error, status = Open3.capture3("/usr/bin/security", *args)
  UI.user_error!("Local signing #{args.first} failed (exit #{status.exitstatus}); command output withheld") unless status.success?
  output
end

def local_signing_keychains
  local_signing_security("list-keychains", "-d", "user").lines.map { |line| line.strip.delete_prefix('"').delete_suffix('"') }
end

def with_local_signing_keychain
  paths = %w[DIST_P12_PATH DIST_P12_PASSWORD_FILE].map do |name|
    value = ENV[name].to_s
    UI.user_error!("Set #{name} to the existing asset path (EXTERNAL_SERVICES.md §6.7)") if value.empty?
    path = File.expand_path(value)
    UI.user_error!("#{name} must reference a readable file") unless File.file?(path) && File.readable?(path)
    path
  end
  p12_password = File.read(paths[1]).strip
  UI.user_error!("DIST_P12_PASSWORD_FILE is empty") if p12_password.empty?
  keychain_password = SecureRandom.hex(32)
  Dir.mktmpdir("awd-signing-") do |dir|
    keychain = File.join(dir, "signing.keychain-db")
    begin
      local_signing_security("create-keychain", "-p", keychain_password, keychain)
      local_signing_security("set-keychain-settings", "-lut", "7200", keychain)
      local_signing_security("unlock-keychain", "-p", keychain_password, keychain)
      local_signing_security("import", paths[0], "-k", keychain, "-P", p12_password,
                             "-T", "/usr/bin/codesign", "-T", "/usr/bin/security")
      local_signing_security("set-key-partition-list", "-S", "apple-tool:,apple:,codesign:",
                             "-s", "-k", keychain_password, keychain)
      local_signing_security("list-keychains", "-d", "user", "-s", keychain, *local_signing_keychains.reject { |path| path == keychain })
      yield keychain
    ensure
      if File.exist?(keychain)
        begin
          # Preserve concurrent additions; remove only this helper's keychain.
          own_path = File.realpath(keychain)
          remaining = local_signing_keychains.reject { |path| (File.realpath(path) rescue File.expand_path(path)) == own_path }
          local_signing_security("list-keychains", "-d", "user", "-s", *remaining)
        ensure
          local_signing_security("delete-keychain", keychain)
        end
      end
    end
  end
ensure
  p12_password&.clear
  keychain_password&.clear
end

def next_app_build_number
  python = ENV.fetch("ASC_PYTHON", File.expand_path("../.venv/bin/python", __dir__))
  value = sh(python, File.expand_path("../scripts/asc-next-build.py", __dir__)).strip
  UI.user_error!("asc-next-build.py did not return a positive build number") unless value.match?(/\A[1-9]\d*\z/)
  value.to_i
end

# Build-only helper: no ASC calls or uploads. beta/release retain their upload steps.
def build_local_ipa(build)
  UI.user_error!("Build number must be a positive integer") unless build.to_s.match?(/\A[1-9]\d*\z/)
  check_release_environment
  root = File.expand_path("..", __dir__)
  sh("xcodegen", "generate", "--spec", File.join(root, "ios/project.yml"), "--project", File.join(root, "ios"))
  with_local_signing_keychain do |keychain|
    flags = Shellwords.escape("--keychain #{Shellwords.escape(keychain)}")
    ipa = build_app(
      project: File.join(root, "ios/Workdeck.xcodeproj"), scheme: "Workdeck", configuration: "Release",
      export_method: "app-store", output_directory: File.join(root, "ios/build"), output_name: "Workdeck.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{build} OTHER_CODE_SIGN_FLAGS=#{flags}",
      skip_profile_detection: true,
      export_options: { signingStyle: "manual", teamID: "8WKHZVR2W8", provisioningProfiles: app_store_profiles, manageAppVersionAndBuildNumber: false }
    )
    check_release_ipa(ipa)
    ipa
  end
end

platform :ios do
  desc "打包并上传 TestFlight（com.aiworkdeck.mobile.cn，ASC App 6803309103）"
  lane :beta do
    key = asc_key
    build = next_app_build_number
    UI.message("本次 build 号 #{build}")
    ipa = build_local_ipa(build)

    upload_to_testflight(
      ipa: ipa,
      api_key: key,
      app_identifier: "com.aiworkdeck.mobile.cn",
      # 不等处理完是为了省 5-15 分钟；内部测试组是 hasAccessToAllBuilds，
      # 不需要像早先另一条 App 记录那样再补一步分组。
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "现场拍摄与本地归档：拍照/录像、SHA-256、时间与地点。"
    )
  end
end

# ---------------- 正式上架（App Store，不是 TestFlight） ----------------
# 与 beta 的关系：release 只多做一件事——把构建号与 MARKETING_VERSION
# 对齐到正式版。**上传通道刻意与 beta 相同**：ASC 里 TestFlight 与 App Store
# 共用同一批构建，选哪个发布是版本记录那边的事，不取决于用哪条通道传上去。
#
# 一度改用 upload_to_app_store（deliver）一把梭，2.235.0 上它在 spaceship
# 解析回包时抛 "No data"（上游已知问题），而升 fastlane 会动到现役的
# beta。文案、分级、定价、区域、挂构建、提审因此全部收在
# scripts/asc-listing.py，那边是直接打 REST API，不受 fastlane 版本影响。
#
# **lane 不提审**。提审是对外动作、撤回要重新排队，那一下由人显式去做。

# 版本号只有一个来源：ios/project.yml 的 MARKETING_VERSION。
# 在这儿再写一遍死值，早晚会出现「构建是 1.0.1、ASC 上传到 1.0.0」。
def marketing_version
  spec = File.read(File.expand_path("../ios/project.yml", __dir__))
  m = spec[/^\s*MARKETING_VERSION:\s*"([^"]+)"/, 1]
  UI.user_error!("ios/project.yml 里读不到 MARKETING_VERSION") if m.nil?
  m
end

platform :ios do
  desc "打正式版包并上传（App Store 侧用 scripts/asc-listing.py 收尾）"
  lane :release do
    key = asc_key
    build = next_app_build_number
    UI.message("#{marketing_version} (#{build})")
    ipa = build_local_ipa(build)

    upload_to_testflight(
      ipa: ipa,
      api_key: key,
      app_identifier: "com.aiworkdeck.mobile.cn",
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "正式版候选。"
    )

    # ICP 备案号（京ICP备2024096997号-13A）ASC 没开放 API，只能在网页
    # 「App 信息 → 中国大陆 ICP 备案号」填。没填就提审会被直接挡下。
    UI.important("提审前确认 ASC 网页已填 ICP 备案号，且 App 名称与备案表逐字一致")
    UI.success("#{marketing_version} (#{build}) 已上传。接着跑：\n" \
               "  .venv/bin/python scripts/asc-listing.py attach #{build}\n" \
               "  .venv/bin/python scripts/asc-listing.py status")
  end
end

# ---------------- CI 打包（GitHub Actions，发行版 macOS runner）----------------
# 为什么存在：打包机跑 macOS beta 时，包里的 BuildMachineOSBuild 记录的是 beta
# 系统号，提审一律被 ITMS-90111 打回——Xcode 与 SDK 都是正式版也救不回来
# （2026-09-01 三个包连测；Apple 邮件文案只提 Xcode/SDK，不提打包机系统，
# 别被它带偏）。正式包因此挪到 GitHub 的发行版 macOS runner 上打。签名材料由
# 工作流从 secrets 落到 $RUNNER_TEMP（先例：桌面仓的 CSC_LINK 同样是 p12 进
# secrets，见 EXTERNAL_SERVICES.md §6.4）。
#
# 环境契约（.github/workflows/appstore-build.yml 负责准备）：
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH  ASC API Key
#   DIST_P12_PATH / DIST_P12_PASSWORD          Distribution 身份的 p12
#                                              （本机 fastlane_build keychain 导出）
#   APPSTORE_PROFILE_PATH                      AI WorkDeck AppStore 描述文件
#   LA_PROFILE_PATH                            同上，Live Activity 扩展的（可缺，见下）
#   WATCH_PROFILE_PATH                         同上，Watch App 的
platform :ios do
  desc "CI：发行版 macOS 上打正式包并上传"
  lane :ci_appstore do
    check_release_environment
    setup_ci   # 建临时 keychain 并设为默认（fastlane_tmp_keychain，空口令）

    # 取构建号要走 ASC API 的 python 脚本，venv 先备好
    sh("cd .. && test -x .venv/bin/python || " \
       "(python3 -m venv .venv && .venv/bin/pip install --quiet pyjwt cryptography)")

    import_certificate(
      certificate_path: ENV.fetch("DIST_P12_PATH"),
      certificate_password: ENV.fetch("DIST_P12_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # 描述文件不走 sigh（私钥不是 fastlane 生成的），直接装进扫描目录。
    # Xcode 16 起换了位置，两处都放，不赌 runner 上的版本。
    ["~/Library/MobileDevice/Provisioning Profiles",
     "~/Library/Developer/Xcode/UserData/Provisioning Profiles"].each do |d|
      dir = File.expand_path(d)
      FileUtils.mkdir_p(dir)
      FileUtils.cp(ENV.fetch("APPSTORE_PROFILE_PATH"),
                   File.join(dir, "aiworkdeck-appstore.mobileprovision"))
      # Live Activity 扩展的描述文件（dev-board#404）：由用户在 ASC 建好
      # （bundle id com.aiworkdeck.mobile.cn.LiveActivity，名 AI WorkDeck
      # LiveActivity AppStore）后加 secret LA_PROFILE_B64，工作流才会导出这个
      # 变量。缺它归档会在 exportArchive 因扩展没有描述文件而失败。
      la = ENV["LA_PROFILE_PATH"]
      if la && File.exist?(la)
        FileUtils.cp(la, File.join(dir, "aiworkdeck-liveactivity-appstore.mobileprovision"))
      end
      FileUtils.cp(ENV.fetch("WATCH_PROFILE_PATH"),
                   File.join(dir, "aiworkdeck-watch-appstore.mobileprovision"))
    end

    sh("cd .. && xcodegen generate --spec ios/project.yml --project ios")

    key = asc_key
    # 不用 latest_testflight_build_number：它只看最新预发布版本下的构建，会漏号
    # （2026-09-02 报 19 而 ASC 已有 20，上传撞 409 buildUpload INVALID_STATE）。
    sh("cd .. && .venv/bin/python -m unittest discover -s scripts/tests")
    build = sh("cd .. && .venv/bin/python scripts/asc-next-build.py").strip.to_i
    UI.message("CI #{marketing_version} (#{build})")
    ipa = build_app(
      project: "ios/Workdeck.xcodeproj", scheme: "Workdeck", configuration: "Release",
      export_method: "app-store", output_directory: "ios/build", output_name: "Workdeck.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{build}",
      skip_profile_detection: true,   # 理由同 release：只认显式映射
      export_options: {
        signingStyle: "manual", teamID: "8WKHZVR2W8",
        provisioningProfiles: app_store_profiles
      })
    check_release_ipa(ipa)
    upload_to_testflight(ipa: ipa, api_key: key, app_identifier: "com.aiworkdeck.mobile.cn",
                         skip_waiting_for_build_processing: true,
                         changelog: ENV["CHANGELOG"] || "CI 构建（发行版 macOS）。")
  end
end
