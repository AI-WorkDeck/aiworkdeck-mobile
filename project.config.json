{
  "appid": "wx67b9a7d0449be0b4",
  "projectname": "AI Workdeck 移动端",
  "description": "现场取证拍摄、同步归档到项目目录、文件管理",
  "miniprogramRoot": "miniprogram/",
  "compileType": "miniprogram",
  "libVersion": "3.5.0",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "bigPackageSizeSupport": true,
    "useCompilerPlugins": [
      "typescript"
    ],
    "ignoreUploadUnusedFiles": true,
    "minifyWXML": true
  },
  "condition": {
    "miniprogram": {
      "list": [
        {
          "name": "项目首页",
          "pathName": "pages/index/index",
          "query": "",
          "scene": null
        },
        {
          "name": "登录",
          "pathName": "pages/login/login",
          "query": "",
          "scene": null
        },
        {
          "name": "项目选择",
          "pathName": "pages/project/project",
          "query": "",
          "scene": null
        },
        {
          "name": "传输队列",
          "pathName": "pages/queue/queue",
          "query": "",
          "scene": null
        }
      ]
    }
  },
  "packOptions": {
    "ignore": [],
    "include": [
      {
        "type": "file",
        "value": "miniprogram/vendor/speech/speech.wasm"
      },
      {
        "type": "file",
        "value": "miniprogram/vendor/speech/MINIMP3-LICENSE"
      },
      {
        "type": "file",
        "value": "miniprogram/vendor/speech/LIBFVAD-LICENSE"
      },
      {
        "type": "file",
        "value": "miniprogram/vendor/speech/LIBFVAD-PATENTS"
      },
      {
        "type": "file",
        "value": "miniprogram/vendor/speech/LIBFVAD-AUTHORS"
      }
    ]
  }
}
